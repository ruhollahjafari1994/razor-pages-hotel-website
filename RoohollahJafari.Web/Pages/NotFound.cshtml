@page "/404.html"
@{
    ViewData["Title"] = "Page Not Found - Roohollah Jafari";
    ViewData["Description"] = "Page not found - Roohollah Jafari hotel & resort.";
}


        <main>
            <!--======  Start Page Hero Section  ======-->
            <section class="page-hero bg_cover p-r z-1" data-src="/assets/images/innerpage/bg/page-bg.jpg">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <!--=== Page Content ===-->
                            <div class="page-content text-center">
                                <h1>404</h1>
                                <h6>Page not found, but we’ll help you get back on track.</h6>
                                <ul>
                                    <li><a href="index.html">Home</a></li>
                                    <li>404</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </section><!--======  End Page Hero Section  ======-->
            <!--======  Start Error Section  ======-->
            <section class="luxivo-error-sec pt-120 pb-120">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <!--=== Error Content ===-->
                            <div class="luxivo-content-box text-center">
                                <div class="luxivo-image-box mb-30" data-aos="fade-up" data-aos-duration="800">
                                    <img src="/assets/images/innerpage/404/404.png" alt="404 Error">
                                </div>
                                <h1 data-aos="fade-up" data-aos-duration="1200">Alas, that page is not accessible.</h1>
                                <p data-aos="fade-up" data-aos-duration="1400">It appears that nothing was discovered here. Could you try a search or one of the sites below?</p>
                                <div class="luxivo-button" data-aos="fade-up" data-aos-duration="1600">
                                    <a href="index.html" class="theme-btn style-one">Go To Home</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section><!--======  End Error Section  ======-->
        </main>
        