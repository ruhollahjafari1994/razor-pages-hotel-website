                        <div class="col-lg-8">
                            <div class="section-title text-center mb-60">
                                <span class="line d-block mb-10" data-aos="fade-up" data-aos-duration="800"><img src="/assets/images/home-one/gallery/d-line.png" alt="line"></span>
