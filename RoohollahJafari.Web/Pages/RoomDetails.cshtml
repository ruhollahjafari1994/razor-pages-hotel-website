                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="box">
                                                    <h5><i class="far fa-swimmer"></i>Swimming Pool</h5>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="services-list" data-aos="fade-up" data-aos-duration="1600">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="box">
                                                    <h5><i class="far fa-dumbbell"></i>Fitness Center</h5>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="box">
                                                    <h5><i class="far fa-bed"></i>King Size Bed</h5>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="box">
                                                    <h5><i class="far fa-headset"></i>24/7 Support</h5>
                                                </div>
                                            </div>
