                                                <div class="box">
                                                    <h5><i class="far fa-shower"></i>Shower</h5>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="box">
                                                    <h5><i class="far fa-refrigerator"></i>Refrigerator</h5>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="box">
                                                    <h5><i class="far fa-plane-arrival"></i>Airport transport</h5>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="room-content-box" data-aos="fade-up" data-aos-duration="2000">
                                    <h3>Cancellation Policy:</h3>
                                    <p>Cancellations made 48 hours or more before the check-in date will receive a full refund. The full amount of the reservation will be charged at the time of booking.</p>
                                </div>
                                <div class="room-content-box mb-35 spacing-gap" data-aos="fade-up" data-aos-duration="2200">
