                                                    <label>Rooms</label>
                                                    <select class="wide" name="RoomType">
                                                        <option value="01">01 Rooms</option>
                                                        <option value="02">02 Rooms</option>
                                                        <option value="03">03 Rooms</option>
                                                        <option value="04">04 Rooms</option>
                                                    </select>
                                                </div>
                                                <div class="form-group">
