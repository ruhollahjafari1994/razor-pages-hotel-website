                                                    <select class="wide" name="Guests">
                                                        <option value="01">02 Adults</option>
                                                        <option value="02">04 Adults</option>
                                                        <option value="03">06 Adults</option>
                                                        <option value="04">08 Adults</option>
                                                    </select>
                                                </div>
