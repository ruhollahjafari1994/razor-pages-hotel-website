                                                        </label>
                                                    </div>
                                                    <div class="form-check">
                                                        <label class="form-check-label" for="check3">
                                                            <input class="form-input-check" type="checkbox" name="Services" value="Gym & Spa" id="check3">
                                                            Gym & Spa<span>$20 / Total</span>
                                                        </label>
                                                    </div>
                                                    <div class="form-check">
                                                        <label class="form-check-label" for="check4">
                                                            <input class="form-input-check" type="checkbox" name="Services" value="Dinner" id="check4">
                                                            Dinner<span>$25 / day</span>
                                                        </label>
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <button class="theme-btn style-one">BOOK NOW<i class="far fa-arrow-right"></i></button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
