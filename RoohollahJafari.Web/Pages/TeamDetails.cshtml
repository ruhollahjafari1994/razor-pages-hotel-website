@page "/team-details.html"
@model RoohollahJafari.Web.Pages.TeamDetailsModel
@{
    ViewData["Title"] = "Team Details - Roohollah Jafari";
    ViewData["Description"] = "Team Details - Roohollah Jafari hotel & resort.";
}


        <main>
            <!--======  Start Page Hero Section  ======-->
            <section class="page-hero bg_cover p-r z-1" data-src="/assets/images/innerpage/bg/page-bg.jpg">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <!--=== Page Content ===-->
                            <div class="page-content text-center">
                                <h1>Team Details</h1>
                                <h6>Discover The blog where luxury, comfort, and adventure come together.</h6>
                                <ul>
                                    <li><a href="index.html">Home</a></li>
                                    <li>Team Details</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </section><!--======  End Page Hero Section  ======-->
            <!--======  Start Team Details Section  ======-->
            <section class="luxivo-team-details-sec pt-120 pb-100">
                <div class="container">
                    <div class="team-details-wrapper">
                        <div class="luxivo-team-main" data-aos="fade-up" data-aos-duration="800">
                            <div class="row align-items-center align-items-lg-start">
                                <div class="col-lg-4">
                                    <div class="member-image">
                                        <img src="/assets/images/innerpage/team/team-single1.jpg" alt="Member Image">
                                    </div>
                                </div>
                                <div class="col-lg-8">
                                    <div class="member-info">
                                        <h4 class="title">Leslie Alexander</h4>
                                        <span class="position">CEO & Founder</span>
                                        <p>Adipiscing elit. Mauris viverra nisl quis mollis laoreet. Ut eget lacus a felis accumsan pharetra in dignissim enim. In amet odio mollis urna aliquet volutpat. Sed bibendum nisl vehicula imperdiet imperdiet, augue massa fringilla.</p>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="info-box mb-30">
                                                    <h5>Experience:</h5>
                                                    <span>10 Years</span>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="info-box mb-30">
                                                    <h5>Phone:</h5>
                                                    <span><a href="tel:+208-555-0112">+208-555-0112</a></span>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="info-box mb-30">
                                                    <h5>Email:</h5>
                                                    <span><a href="mailto:info@@yourdomain.com">info@@yourdomain.com</a></span>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="info-box mb-30">
                                                    <h5>Address:</h5>
                                                    <span>121 King Street, Melbourne</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="social-box">
                                            <a href="#"><i class="fab fa-facebook-f"></i></a>
                                            <a href="#"><i class="fab fa-twitter"></i></a>
                                            <a href="#"><i class="fab fa-instagram"></i></a>
                                            <a href="#"><i class="fab fa-linkedin-in"></i></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-90 align-items-center">
                            <div class="col-lg-7">
                                <div class="luxivo-content-box pe-xl-5 mb-5 mb-xl-0" data-aos="fade-up" data-aos-duration="1000">
                                    <h3 class="mb-15">Professional Info</h3>
                                    <p class="mb-15">Consectetur adipisicing elit, sed do eiusmod tempor is incididunt ut labore et dolore of magna aliqua. Ut enim ad minim veniam, made of owl the quis nostrud exercitation ullamco laboris nisi ut aliquip</p>
                                    <p class="mb-15">The is ipsum dolor sit amet consectetur adipiscing elit. Fusce eleifend porta arcu In hac augu ehabitasse the is platea augue thelorem turpoi dictumst. In lacus libero faucibus at malesuada.The is ipsum dolor sit amet consectetur adipiscing elit.</p>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="luxivo-skill-list">
                                    <div class="luxivo-skill-item mb-35" data-aos="fade-up" data-aos-duration="1200">
                                        <div class="progress-title">
                                            <h6>Business consultants<span>90%</span></h6>
                                        </div>
                                        <div class="progress">
                                            <div class="progress-bar" style="width: 80%;"></div>
                                        </div>
                                    </div>
                                    <div class="luxivo-skill-item mb-35" data-aos="fade-up" data-aos-duration="1400">
                                        <div class="progress-title">
                                            <h6>Tour Guide<span>70%</span></h6>
                                        </div>
                                        <div class="progress">
                                            <div class="progress-bar" style="width: 70%;"></div>
                                        </div>
                                    </div>
                                    <div class="luxivo-skill-item mb-35" data-aos="fade-up" data-aos-duration="1600">
                                        <div class="progress-title">
                                            <h6>Prelanding<span>85%</span></h6>
                                        </div>
                                        <div class="progress">
                                            <div class="progress-bar" style="width: 85%;"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section><!--======  End Team Details Section  ======-->
            <!--======  Start Team Contact Section  ======-->
            <section class="luxivo-team-contact gray-color pt-120 pb-120">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-xl-7">
                            <!-- Section Title -->
                            <div class="section-title text-center mb-45">
                                <span class="sub-title" data-aos="fade-down" data-aos-duration="800">Contact With Us Now</span>
                                <h2 data-aos="fade-up" data-aos-duration="1000">Let’s Discuss Further To Get Better Results</h2>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12">
                            <!-- Contact Form -->
                            @if (TempData["Success"] != null)
                            {
                                <div class="alert alert-success" role="alert">@TempData["Success"]</div>
                            }
                            @if (TempData["Error"] != null)
                            {
                                <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
                            }
                            <form class="contact-form" autocomplete="off" method="post" data-aos="fade-up" data-aos-duration="1200">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <input type="text" class="form_control" placeholder="Enter Name" name="name" required>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <input type="email" class="form_control" placeholder="Enter Email" name="email" required>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <input type="text" class="form_control" placeholder="Enter Subject" name="subject" required>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <input type="text" class="form_control" placeholder="Enter Phone" name="phone" required>
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <textarea class="form_control" name="message" placeholder="Enter Message" rows="9"></textarea>
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group text-center">
                                            <button class="theme-btn style-one">SEND MESSAGE<i class="far fa-arrow-right"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </section><!--======  End Team Contact Section  ======-->
        </main>
        