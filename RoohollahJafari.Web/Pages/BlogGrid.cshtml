@section Scripts {
    <script>
        (function () {
            var q = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["Search"] as string));
            if (!q) return;
            q = q.toLowerCase();
            var items = document.querySelectorAll('.luxivo-blog-post-item');
            var shown = 0;
            for (var i = 0; i < items.length; i++) {
                var match = items[i].textContent.toLowerCase().indexOf(q) !== -1;
                items[i].style.display = match ? '' : 'none';
                if (match) shown++;
            }
            var banner = document.getElementById('search-banner-text');
            if (banner && shown === 0) {
                banner.textContent = 'No posts matched \u201C' + q + '\u201D \u2014 try another keyword.';
            }
        })();
    </script>
}
