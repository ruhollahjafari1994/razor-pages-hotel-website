                                <h1>Relax Stay, Double The Fun</h1>
                                <h6>Enjoy great deals only Roohollah Jafari hotel</h6>
                                <ul>
                                    <li><a href="index.html">Home</a></li>
                                    <li>Offer Details</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </section><!--======  End Page Hero Section  ======-->
            <!--======  Start offer Details Section  ======-->
            <section class="luxivo-offer-details-sec pt-120 pb-75">
                <div class="container">
                    <div class="row">
